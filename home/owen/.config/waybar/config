{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 5,
  "output": "DP-1",
  "reload_style_on_change": true,

  "modules-left": ["custom/youtube", "tray"],
  "modules-center": ["clock"],
  "modules-right": ["bluetooth", "network", "wireplumber"],

  "custom/youtube": {
    "exec": "/home/owen/.config/waybar/scripts/audio.sh",
    "interval": 1,
    "on-click": "youtube-music"
  },

  "clock": {
    "format": "{:%m.%d.%Y | %I:%M}",
    "interval": 1
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "on-click": "blueman-manager"
  },

  "wireplumber": {
    "format": "󰕾   {volume}%",
    "max-volume": 100,
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "network": {
    "format": "",
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "nm-connection-editor"
  },

  "tray": {
    "icon-size": 20,
    "spacing": 14
  }
}
